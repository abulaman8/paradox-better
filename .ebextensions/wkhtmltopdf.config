container_commands:
    1_install_wkhtmltopdf:
        command: dnf -y install fontconfig libXrender libXext xorg-x11-fonts-Type1 xorg-x11-fonts-75dpi freetype libpng-devel zlib libjpeg-turbo openssl icu
        ignoreErrors: false

    2_install_wkhtmltopdf:
        # see: https://wkhtmltopdf.org/downloads.html for updates
        command: dnf -y install wkhtmltopdf
        test: test ! -f .wkhtmltopdf

    3_install_wkhtmltopdf:
        command: touch .wkhtmltopdf
